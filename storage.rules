rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- Notices Storage Rules ---
    match /notices/{noticeId}/{allPaths=**} {
      // Anyone can view assets/notices files
      allow read: if true;
      
      // File upload or modification is restricted strictly to users registered as 'admin' in Firestore using their Auth UID
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // --- Default General Files Rules ---
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
